pipeline {
    agent any

    stages {
        stage('Hello') {
            steps {
                echo 'Hello Chahat!'
            }
        }

        stage('Build') {
            steps {
                echo 'Build Started'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Successful'
            }
        }
    }

  post {
      success {
          echo 'pipeline completed successfully'
      }
      failure {
          echo 'pipeline failed'
      }
      always {
          echo 'pipeline exucation finished'
      }
   }
}
